# Cloud-Company Google ADK 環境変数テンプレート
# このファイルを .env にコピーして使用してください
# cp .env.example .env  (Linux/Mac)
# Copy-Item .env.example .env  (Windows PowerShell)

# ─── LLM 設定 ─────────────────────────────────────────────
# ANTHROPIC_API_KEY が設定されている場合、Claude が優先されます
# 未設定の場合は GEMINI_API_KEY を使用した Gemini がデフォルトになります

# Claude API キー (優先)
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini API キー (フォールバック)
# GEMINI_API_KEY=AIza...

# ─── 出力設定 ─────────────────────────────────────────────
# 生成されるプロジェクトの出力先ディレクトリ (既存の cloud-company/projects/ と同形式)
OUTPUT_DIR=./output

# ─── 参照設定 ─────────────────────────────────────────────
# 既存の cloud-company リポジトリのパス (Manifesto 読み込みに使用)
CLOUD_COMPANY_PATH=../cloud-company
